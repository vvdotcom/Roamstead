# Frontend server-side proxy
API_URL=http://127.0.0.1:8000

# Google Cloud production integration
GCP_PROJECT_ID=
GCP_REGION=us-central1
VERTEX_LOCATION=us-central1
FIRESTORE_DATABASE=(default)
PERSISTENCE_BACKEND=sqlite
PUBSUB_TOPIC=roamstead-events
LISTING_IMAGE_BUCKET=
WEB_ORIGIN=
ROAMSTEAD_GEMINI_MODEL=gemini-3.5-flash
ROAMSTEAD_GEMINI_IMAGE_SEARCH_MODEL=gemini-3.1-flash-image
ENABLE_ADK_AGENT=0
GEMINI_API_KEY=

# Google Maps browser bundle. Restrict this key by API and HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
ENABLE_GEMMA_CRITIC=1
ROAMSTEAD_GEMMA_MODEL=gemma-4-26b-a4b-it
# Optional: private Gemma 4 vLLM service. Leave blank to use hosted Gemma 4 through the Gemini API.
GEMMA_CRITIC_URL=
GEMMA_CRITIC_AUTH=iam
GEMMA_CRITIC_AUDIENCE=
GEMMA_CRITIC_TIMEOUT_SECONDS=45
GEMMA_PHOTOS_PER_LISTING=1
ADK_SPECIALIST_TIMEOUT_SECONDS=45
ROAMSTEAD_WORKFLOW_VERSION=partner-coordinator-v2
ROAMSTEAD_PROMPT_VERSION=preference-interpreter-v1
# Production-only, redacted ADK event analytics and Cloud Trace correlation.
ENABLE_BIGQUERY_AGENT_ANALYTICS=0
ROAMSTEAD_AGENT_ANALYTICS_DATASET=roamstead_agent_analytics
ROAMSTEAD_AGENT_ANALYTICS_TABLE=agent_events
ENABLE_CLOUD_TRACE=0
ENABLE_SEMANTIC_MEMORY=1
ROAMSTEAD_EMBEDDING_MODEL=gemini-embedding-001
ROAMSTEAD_EMBEDDING_DIMENSION=768
ROAMSTEAD_MEMORY_TOP_K=5
ROAMSTEAD_MEMORY_MAX_CHARS=6000
ROAMSTEAD_MEMORY_MAX_COSINE_DISTANCE=0.30
ROAMSTEAD_EMBEDDING_TIMEOUT_SECONDS=20
ENABLE_MEMORY_CRITIC=1
ROAMSTEAD_MEMORY_CRITIC_MODEL=gemma-4-31b-it
MEMORY_CRITIC_TIMEOUT_SECONDS=45
LIVE_LISTING_CACHE_MINUTES=30
LIVE_LISTING_SEARCH_TIMEOUT_SECONDS=180
LIVE_LISTING_REDIRECT_TIMEOUT_SECONDS=20
LIVE_LISTING_SEARCH_CONCURRENCY=1
LIVE_LISTING_SEARCH_COOLDOWN_SECONDS=5
LIVE_LISTING_BATCH_SIZE=6
LIVE_LISTING_MAX_BATCHES_PER_BAND=12
LIVE_LISTING_IMAGE_BATCH_SIZE=1
LIVE_LISTING_IMAGE_RETRY_BATCH_SIZE=1
LIVE_LISTING_IMAGE_SEARCH_ATTEMPTS=2
LIVE_LISTING_RETRY_BASE_SECONDS=2
LIVE_LISTING_IMAGE_RETRY_COOLDOWN_SECONDS=1
LISTING_REFRESH_HOURS=168
LISTING_CATALOG_TARGET=100
LISTING_MIN_PER_CORE_BAND=20
LISTING_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=30
LISTING_IMAGE_MAX_BYTES=10000000
LISTING_GALLERY_MAX_IMAGES=10
LISTING_GALLERY_SEARCH_ATTEMPTS=2
LISTING_GALLERY_UPLOAD_WINDOW_MINUTES=120
LISTING_MIN_PUBLISHABLE_PHOTOS=1
LISTING_RETENTION_DAYS=7
LISTING_SCHEDULER_CHECK_SECONDS=3600
LISTING_MODE_COOLDOWN_SECONDS=60
ENABLE_WEEKLY_LISTING_REFRESH=1
# Approval-gated Decision Watch. The maintenance job never processes more than five watches per run.
ROAMSTEAD_WATCH_INTERVAL_DAYS=7
ROAMSTEAD_WATCH_MAX_PER_RUN=5
ROAMSTEAD_WATCH_HTTP_TIMEOUT_SECONDS=8
ENABLE_CATALOG_REFRESH_IN_MAINTENANCE=1
ROAMSTEAD_DATABASE_PATH=data/roamstead.db
VND_PER_USD=26000
